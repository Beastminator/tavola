# Secret part of the invite link: https://<your-app>/join/<GROUP_INVITE_TOKEN>
# Change it to rotate the link (logs everyone out; they re-open the new link and pick their name).
GROUP_INVITE_TOKEN=pick-something-long-and-random
# Signs the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Neon Postgres URL in production. Leave empty locally to use the embedded PGlite DB in .data/
DATABASE_URL=
